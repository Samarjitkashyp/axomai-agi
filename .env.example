# AxomAI AGI Environment Configuration Example
PROJECT_NAME="AxomAI AGI"
ENV="development"

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=axomai_agi_user
DB_PASSWORD=your_password_here
DB_NAME=axomai_agi

DATABASE_URL=postgresql://axomai_agi_user:your_password_here@localhost:5432/axomai_agi
ASYNC_DATABASE_URL=postgresql+asyncpg://axomai_agi_user:your_password_here@localhost:5432/axomai_agi

GEMINI_API_KEY=
OPENAI_API_KEY=

