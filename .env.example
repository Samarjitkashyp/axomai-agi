# AxomAI AGI Environment Configuration Example
# Copy this file to .env and insert your real credentials.
# NEVER commit your actual .env file to version control.

PROJECT_NAME="AxomAI AGI"
ENV="development"

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=axomai_agi_user
DB_PASSWORD=YOUR_STRONG_SECURE_PASSWORD_HERE
DB_NAME=axomai_agi

DATABASE_URL=postgresql://axomai_agi_user:YOUR_STRONG_SECURE_PASSWORD_HERE@localhost:5432/axomai_agi
ASYNC_DATABASE_URL=postgresql+asyncpg://axomai_agi_user:YOUR_STRONG_SECURE_PASSWORD_HERE@localhost:5432/axomai_agi

# Optional Frontier LLM Credentials
GEMINI_API_KEY=
OPENAI_API_KEY=
